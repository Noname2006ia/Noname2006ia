@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;1,500&family=Inter:wght@400;500;700&display=swap');
:root{
    --cor-principal: #022601;
    --cor-painel:#4F7302;
    --cor-painel2:#4f7302cb;
    --cor-texto:#f5f1e8;
    --cor-texto-secundario:#c9d4cb;
    --cor-destaque:#f2c14e;
    --cor-destaque2:#7ec8e3;
    --radius: 14px;
    --font-display: 'Fraunces', Georgia, serif;
    --font-body: 'Inter', system-ui, sans-serif;
}
*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    /* box-sizing: border-box = padding e borda contam DENTRO da largura definida,
    evitando que elementos "estourem" o tamanho calculado. */
}
html{
    scroll-behavior: smooth;
    /* Faz os links internos (ex: <a href="#recursos">) rolarem suavemente
    até a seção, em vez de "pular" instantaneamente. */
}
body{
    background-color: var(--cor-principal);
    color: var(--cor-texto);
    font-family: var(--font-body);
    line-height: 1.65;
    background-image: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.03), transparent 40%)
    radial-gradient(circle at 80% 60%, rgba(255,255,255,0.025), transparent 45%)
    ;
}
h1,h2,h3{
    font-family: var(--font-display);
    line-height: 1.2;
}
a{
    color: var(--cor-destaque2);
}
 /* Acessibilidade: contorno visível ao navegar com Tab, em vez de
    remover o foco (erro comum). Quem navega só pelo teclado precisa
    ver onde está. */
:focus-visible{
    outline: 3px solid var(--cor-destaque);
    outline-offset: 3px;
}
 /* Respeita quem configurou o sistema para reduzir animações
    (ex: pessoas com enjoo por movimento). Zera transições/animações
    nesses casos. */
@media (prefers-reduced-motion: reduce){
    *{animation: none !important; transition: none !important;}
}
.container{
    max-width: 1100px;
    margin-inline: auto;
    /* margin-inline é a versão moderna e "lógica" de margin-left/right:
    funciona automaticamente em idiomas escritos da direita pra
    esquerda também. Aqui centraliza o conteúdo horizontalmente. */
    padding-inline: 24px;
}
header{
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--cor-principal) 88%, transpare nt);
    /* color-mix() é uma função CSS moderna que mistura duas cores em
    proporção — aqui, 88% da cor de fundo + transparência, criando
    um efeito de "vidro fosco" (glassmorphism) sem precisar de imagem. */
    backdrop-filter: blur(8px);
    /* Borra o conteúdo que fica ATRÁS do header ao rolar a página,
    reforçando a sensação de camada flutuante por cima do conteúdo. */
    border-bottom: 1px solid var(--cor-painel2);
}
nav.container{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 18px;
}
.logo{
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
}
.logo span{
    color: var(--cor-texto);
}
nav ul{
    list-style: none;
    display: flex;
    gap: 32px;
}
nav ul a{
    color: var(--cor-texto-secundario);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
}
nav ul a:hover{
    color: var(--cor-texto);
}
.heroi{
    padding-block: 90px 70px;
}
.heroi .container{
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    /* Duas colunas: a primeira (texto) um pouco mais larga que a
    segunda (ilustração). "fr" = fração do espaço disponível. */
    gap: 60px;
    align-items: center;
}
.sombrancelha{
    display: inline-block;
    color: var(--cor-texto);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    /* letter-spacing largo + caixa alta é um recurso tipográfico clássico
    para "rótulos" pequenos: dá formalidade sem precisar de tamanho grande. */
    text-transform: uppercase;
    margin-bottom: 18px;
}
.heroi h1{
    font-size: clamp(2.4 rem, 4vw + 1rem, 3.6rem);
    /* clamp(mínimo, valor-fluido, máximo) faz o tamanho da fonte
    "respirar" com a largura da tela sem precisar de várias
    media queries: nunca fica menor que 2.4rem nem maior que 3.6rem,
    e entre esses limites cresce suavemente com o viewport (vw). */
    font-weight: 600;
    margin-bottom: 22px;
}
.heroi h1 em{
    font-style: italic;
    color: var(--cor-destaque);
    /* itálico serifado é o "traço de giz" do design: usado só na
    palavra mais importante da frase para criar contraste sem
    precisar de outra cor extra na hero inteira. */
}
.heroi p{
    color: var(--cor-texto-secundario);
    font-size: 1.1rem;
    max-width: 480px;
    margin-bottom: 34px;
}
.acao-heroi{
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}
.btn{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 999px;
    /* border-radius bem alto (999px) força o formato de "pílula"
    independente do tamanho do botão — mais amigável que um
    retângulo com cantos levemente arredondados. */
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.btn-primary{
    background: var(--cor-destaque);
    color: var(--cor-principal);
}
.btn-primary:hover{
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -8px #f2c14e80;
    /* Sombra colorida (mesma cor do botão, com opacidade) em vez de
    preta genérica: reforça a cor do elemento em vez de só "escurecer". */
}
.btn-ghost{
    background: transparent;
    color: var(--cor-texto);
    border: 1px solid var(--cor-destaque2);
}
.btn-ghost:hover{
    border-color: var(--cor-texto-secundario);
}
.card-stack{
    position: relative;
    height: 340px;
}
.flashcard{
    position: absolute;
    inset: 0;
    /* "inset: 0" é o atalho moderno para top:0; right:0; bottom:0; left:0;
    faz o elemento preencher todo o espaço do pai (.card-stack). */
    background: var(--cor-destaque);
    border: 1px solid var(--cor-destaque2);
    border-radius: var(--radius);
    padding: 28px;
    box-shadow: 0px 20px 40px -20px rgba(0,0,0,0.5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
/* Cada carta tem uma rotação e profundidade (z-index) diferente,
criando a ilusão de uma pilha física levemente desarrumada. */
.flashcard:nth-child(1){
    transform: rotate(-6deg);
    z-index: 1;
}
.flashcard:nth-child(2){
    transform: rotate(3deg) translateY(6px);
    z-index: 2;
}
.flashcard:nth-child(3){
    transform: rotate(-1deg) translateY(2px);
    z-index: 3;
    background: var(--cor-painel2);
}
.flashcard:hover{
    transform: rotate(0deg) translateY(-6px) scale(1.02);
    transition: transform 0.3s ease;
    /* Ao passar o mouse na carta do topo, ela "endireita" e sobe
    levemente — um micro-detalhe que recompensa a interação
    sem exagerar em movimento. */
}
.flashcard .tag{
    font-size: 0.75rem;
    color: var(--cor-destaque2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}
.flashcard .question{
    font-family: var(--font-display);
    font-size: 1.3rem;
}
.section{
    padding-block: 90px;
}
.cabeca-de-secao{
    max-width: 560px;
    margin-bottom: 56px;
}
.cabeca-de-secao .sombrancelha{
    margin-bottom: 14px;
}
.cabeca-de-secao h2{
    font-size: clamp(1.8rem, 2.5vw + 1rem, 2.6rem);
    font-weight: 600;
}
.cabeca-de-secao p{
    color: var(--cor-texto-secundario);
    margin-top: 14px;
}
.passos{
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
}
.passo{
    border-top: 3px solid var(--cor-painel);
    /* Uma borda superior grossa funciona como um "marcador de giz"
    no topo de cada bloco — reforça a identidade visual sem
    precisar de ícones externos. */
    padding-top: 20px;
}
.passo .numero{
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--cor-destaque2);
    -webkit-text-stroke: 1px var(--cor-texto-secundario);
    /* -webkit-text-stroke desenha só o CONTORNO da letra, deixando
    o miolo "vazado" — um número grande, mas discreto, que não
    compete visualmente com o título do passo. */
}
.passo h3{
    font-size: 1.2rem;
    margin: 10px 0 8px;
}
.passo p{
    color: var(--cor-texto-secundario);
    font-size: 0.95rem;
}
.features-grid{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    /* Esse é um dos truques mais úteis do CSS Grid moderno:
    "auto-fit" + "minmax" faz o navegador decidir SOZINHO quantas
    colunas cabem, sem precisar de media query nenhuma. Cada coluna
    nunca fica menor que 240px; se sobrar espaço, elas dividem
    igualmente (1fr). Encolha a janela do navegador e veja os
    cards se reorganizarem automaticamente. */
    gap: 24px;
}
.feature-card{
    background: var(--cor-painel);
    border: 1px solid var(--cor-painel2);
    border-radius: var(--radius);
    padding: 20px;
    transition: border-color 0.2s ease, transform 0.2s ease;
}
.feature-card:hover{
    border-color: var(--cor-destaque2);
    transform: translateY(4px);
}
.feature-card .icone{
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--cor-destaque);
    color: var(--cor-texto);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    margin-bottom: 18px;
}
.feature-card h3{
    font-size: 1.05rem;
    margin-bottom: 8px;
}
.feature-card p {
    color: var(--cor-texto-secundario);
    font-size: 0.92rem;
}
.testemunha{
    background: var(--cor-destaque);
    border-radius: var(--radius);
    padding: 48px;
    max-width: 720px;
    margin-inline: auto;
    transform: rotate(-1.2deg);
    /* Rotação sutil no bloco inteiro, como um bilhete colado meio torto
    no mural — reforça o tema sem precisar de nenhuma imagem. */
}
.testemunha::before{
    content: "“";
    /* ::before injeta conteúdo ANTES do elemento via CSS puro,
    sem precisar escrever esse caractere no HTML. Muito usado
    para aspas decorativas, ícones e pequenos ornamentos. */
    font-family: var(--font-display);
    font-size: 5rem;
    color: var(--cor-destaque);
    position: absolute;
    top: 10px;
    left: 24px;
    line-height: 1;
    opacity: 0.5;
}
.testemunha p.quote{
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-style: italic;
    margin-bottom: 20px;
    position: relative;
}
.testemunha .autor{
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
    color: var(--cor-texto-secundario);
}
.testemunha .avatar{
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--cor-destaque2);
    color: #022601;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
}
.cta-section {
    background: var(--cor-painel);
    border-radius: 24px;
    padding: 70px 40px;
    text-align: center;
    margin-inline: 24px;
    /* Aqui uso margin-inline diretamente (sem .container) porque
    quero que esse bloco tenha cantos arredondados e "respire"
    dentro da tela — um container cheio da borda-a-borda ficaria
    estranho com border-radius grande. */
}
.cta-section h2{
    font-size: clamp(1.8rem, 3vw + 1rem, 2.6rem);
    max-width: 600px;
    margin-inline: auto 24px auto;
    margin-bottom: 16px;
}
.cta-section p{
    color: var(--cor-texto-secundario);
    max-width: 480px;
    margin-inline: auto;
    margin-bottom: 30px;
}
footer{
    border-top: 1px solid var(--cor-destaque2);
    margin-top: 90px;
    padding-block: 32px;
}
footer .container{
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    color: var(--cor-texto-secundario);
    font-size: 0.85rem;
}
footer nav ul{
    display: flex;
    gap: 20px;
    list-style: none;
}
footer nav ul a{
    color: var(--cor-texto-secundario);
    text-decoration: none;
}
footer nav ul a:hover{
    color: var(--cor-texto);
}
@media(max-width: 780px){
    .heroi .container {
        grid-template-columns: 1fr;
    }
    .card-stack{
        height: 260px;
        order: -1;
    }
    /* "order" muda a ORDEM VISUAL de um item dentro do grid/flex
    sem mexer na ordem real do HTML — aqui, a ilustração passa
    a aparecer ANTES do texto no celular, mesmo estando depois
    no código. Bom para acessibilidade: leitores de tela ainda
    seguem a ordem lógica do HTML. */
    .passos{
        grid-template-columns: 1fr;
    }
    nav ul{
        display: none;
    }
}
